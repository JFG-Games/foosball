# ── Dependencies ─────────────────────────────────────────────
node_modules/

# ── Build output ─────────────────────────────────────────────
dist/
dist-ssr/
*.tsbuildinfo

# ── Vite ─────────────────────────────────────────────────────
.vite/

# ── Secrets ──────────────────────────────────────────────────
# Real keys never belong in git. `.env.example` is the tracked template.
.env
.env.*
!.env.example

# ── Runtime data (entitlements)
data/

# ── Logs ─────────────────────────────────────────────────────
*.log
logs/
.logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── Test output ──────────────────────────────────────────────
coverage/
.nyc_output/

# ── Editors ──────────────────────────────────────────────────
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
*.swo
*~

# ── OS cruft ─────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
