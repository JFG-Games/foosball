# Copy to `.env` and fill in. Never commit the real `.env`.

# ── Authoritative game server ────────────────────────────────
PORT=8080

# ── Vatar Games (Lagos Life) API ─────────────────────────────
# Get SANDBOX (test) keys at https://lagoslife.app/developers, then
# live keys after your game passes review.
VATAR_API_BASE=https://lagoslife.app/api/games/v1
# Optional: when set, session tokens issued for any other game are rejected.
VATAR_GAME_ID=your-game-id
# Server secret. Signs API calls. NEVER expose this to the browser.
VATAR_SECRET=your-server-secret
# Signs POST /matches/{id}/result (HMAC-SHA256). Server only.
VATAR_RESULTS_SECRET=your-results-secret
VATAR_SANDBOX=true

# ── Browser client (Vite) ────────────────────────────────────
# Only variables prefixed `VITE_` reach the browser bundle.
VITE_SERVER_URL=ws://localhost:8080
